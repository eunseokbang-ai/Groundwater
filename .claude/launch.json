{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "groundwater-dashboard",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "src/groundwater/viz/dashboard/app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8502"
      ],
      "port": 8502
    },
    {
      "name": "ortho-history",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["webapp/ortho_history/serve.py", "--port", "8611", "--no-browser"],
      "port": 8611
    },
    {
      "name": "tools-snap",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "groundwater.viz.wall_digitizer", "--no-browser", "--port", "8613"],
      "env": {"PYTHONPATH": "src"},
      "port": 8613
    }
  ]
}
